<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>🎁 Diwali Secret Gift Game 🪔</title>
    <link rel="stylesheet" href="style.css"> 
</head>
<body>
    <div class="container">
        <h1>🎁 Diwali Secret Gift Game 🪔</h1>
        <p>Enter your **Unique Player ID** and pick a number between <strong>1 and 10</strong> to get your gift ticket!</p>
        
        <div class="form-group">
            <label for="idField">Enter Your Player ID (e.g., A1, B2):</label><br>
            <input type="text" id="idField" class="idField" placeholder="Your Unique ID" required>
        </div>

        <div class="form-group">
            <label for="guessField">Pick a Number (1-10):</label><br>
            <input type="number" min="1" max="10" required id="guessField" class="guessField">
            <input type="submit" value="Get Your Ticket" class="checkGiftSubmit">
        </div>

        <div class="resultParas">
            <p class="resultText"></p>
        </div>

        <button class="shuffleAndPlay" style="display: none;">Play Again (Shuffle Gifts)</button>
    </div>

    <script src="script.js"></script> 
</body>
</html>
