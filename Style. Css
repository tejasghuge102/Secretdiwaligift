body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fcebeb; 
    color: #333;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
}

.container {
    background: #ffffff;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    text-align: center;
    max-width: 450px;
    width: 90%;
    border: 3px solid #ff6347; 
}

h1 {
    color: #ff4500;
    margin-bottom: 15px;
}

p {
    margin-bottom: 20px;
    font-size: 1.1em;
}

.form-group {
    margin-bottom: 20px;
}

.form-group input {
    padding: 10px;
    margin: 0 5px 10px 5px;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 1em;
    text-align: center;
}

.checkGiftSubmit, .shuffleAndPlay {
    background-color: #008000;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1em;
    font-weight: bold;
    transition: background-color 0.3s;
    margin-top: 5px;
}

.checkGiftSubmit:hover, .shuffleAndPlay:hover {
    background-color: #006400;
}

.resultText {
    margin-top: 25px;
    padding: 15px;
    font-size: 1.5em;
    font-weight: bold;
    min-height: 50px;
    border-radius: 8px;
}
